# Supabase — optional.
# Leave these unset and the app runs against an in-memory store so you can
# click through the whole demo immediately. Fill them in (after running
# supabase/schema.sql) to persist every submission to your project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred over the anon key when present; server-side only.
SUPABASE_SERVICE_ROLE_KEY=
