# Supabase — optional.
# Leave these unset and the app runs against an in-memory store so you can
# click through the whole demo immediately. Fill them in (after running
# supabase/schema.sql) to persist every submission to your project.
NEXT_PUBLIC_SUPABASE_URL=

# Either key style works — the new publishable key or the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Preferred over the client keys when present; server-side only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
